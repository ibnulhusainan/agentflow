{
  "schema_version": 1,
  "state_root": ".agent",
  "small_task": {
    "max_files": 3,
    "max_changed_lines": 200,
    "forbid_cross_module": true,
    "forbid_contract_change": true
  },
  "limits": {
    "max_attempts": 3,
    "max_spawn_depth": 1,
    "max_children": 0
  },
  "verify": {
    "commands": []
  },
  "exclude": [
    "node_modules/**",
    ".git/**",
    ".agent/**",
    ".agentflow/**",
    ".agentflow-backup/**",
    ".opencode/**",
    ".cursor/**",
    "opencode.jsonc"
  ],
  "agents": {
    "consultant": {
      "agent": "consultant",
      "order": 0,
      "enabled": true
    },
    "conductor": {
      "agent": "conductor",
      "order": 1,
      "enabled": true
    },
    "analyzer": {
      "agent": "analyzer",
      "order": 2,
      "enabled": true
    },
    "planner": {
      "agent": "planner",
      "order": 3,
      "enabled": true
    },
    "executor": {
      "agent": "executor",
      "order": 4,
      "enabled": true
    },
    "reviewer": {
      "agent": "reviewer",
      "order": 5,
      "enabled": true
    }
  }
}
